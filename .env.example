# Paystack secret key (use sk_test_... locally and sk_live_... in production).
PAYSTACK_SECRET_KEY=

# Legacy Stripe settings only for existing Stripe checkout sessions/webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Optional: enable AI-assisted product photo drafts in the admin dashboard.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: enable clothing image generation in the admin dashboard.
VENICE_API_KEY=
VENICE_IMAGE_MODEL=gpt-image-2-5-flare
VENICE_REFERENCE_IMAGE_MODEL=krea-v2-large
VENICE_TEXT_MODEL=qwen3-5-9b

# Optional: leave these blank to use the included starter catalog.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Admin access. Use a unique, long password and a random session secret.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=